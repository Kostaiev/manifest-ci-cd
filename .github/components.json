{
  "version": 1,
  "components": {
    "node-exporter": {
      "paths": [
        "ansible/roles/node_exporter/**",
        "ansible/playbooks/node-exporter.yml"
      ],
      "playbook": "ansible/playbooks/node-exporter.yml"
    },
    "prometheus": {
      "paths": [
        "ansible/roles/prometheus/**",
        "ansible/playbooks/prometheus.yml"
      ],
      "playbook": "ansible/playbooks/prometheus.yml"
    },
    "grafana": {
      "paths": [
        "ansible/roles/grafana/**",
        "ansible/playbooks/grafana.yml"
      ],
      "playbook": "ansible/playbooks/grafana.yml"
    }
  }
}
